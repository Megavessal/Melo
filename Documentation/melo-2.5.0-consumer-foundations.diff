+import SwiftUI
+
+@MainActor
+struct SettingsGuideView: View {
+    @State private var searchText = ""
+    @State private var selectedCategory: SettingsGuideCategory?
+
+    private var entries: [SettingsGuideEntry] {
+        SettingsGuideEntry.all.filter { entry in
+            (selectedCategory == nil || entry.category == selectedCategory) && entry.matches(searchText)
+        }
+    }
+
+    var body: some View {
+        HSplitView {
+            List(selection: $selectedCategory) {
+                Label("All Topics", systemImage: "text.book.closed")
+                    .tag(Optional<SettingsGuideCategory>.none)
+                ForEach(SettingsGuideCategory.allCases) { category in
+                    Text(category.rawValue).tag(Optional(category))
+                }
+            }
+            .frame(minWidth: 155, idealWidth: 175, maxWidth: 205)
+
+            VStack(alignment: .leading, spacing: 14) {
+                VStack(alignment: .leading, spacing: 4) {
+                    Text("Melo Guide")
+                        .font(.system(size: 22, weight: .semibold, design: .rounded))
+                    Text("Search for a setting or describe what you are trying to do.")
+                        .font(.system(size: 12))
+                        .foregroundStyle(.secondary)
+                }
+
+                TextField("Search settings", text: $searchText)
+                    .textFieldStyle(.roundedBorder)
+
+                if entries.isEmpty {
+                    ContentUnavailableView.search(text: searchText)
+                } else {
+                    ScrollView {
+                        LazyVStack(alignment: .leading, spacing: 10) {
+                            ForEach(entries) { entry in
+                                guideCard(entry)
+                            }
+                        }
+                        .padding(.bottom, 16)
+                    }
+                    .scrollIndicators(.never)
+                }
+            }
+            .padding(20)
+            .frame(maxWidth: .infinity, maxHeight: .infinity, alignment: .topLeading)
+        }
+    }
+
+    private func guideCard(_ entry: SettingsGuideEntry) -> some View {
+        VStack(alignment: .leading, spacing: 5) {
+            HStack {
+                Text(entry.title)
+                    .font(.system(size: 13, weight: .semibold))
+                Spacer()
+                Text(entry.category.rawValue)
+                    .font(.system(size: 9, weight: .medium))
+                    .foregroundStyle(.secondary)
+            }
+            Text(entry.summary)
+                .font(.system(size: 12))
+            if !entry.details.isEmpty {
+                Text(entry.details)
+                    .font(.system(size: 11))
+                    .foregroundStyle(.secondary)
+                    .fixedSize(horizontal: false, vertical: true)
+            }
+        }
+        .padding(12)
+        .frame(maxWidth: .infinity, alignment: .leading)
+        .background(RoundedRectangle(cornerRadius: 11).fill(DesignTokens.Colors.glassFill))
+        .overlay(RoundedRectangle(cornerRadius: 11).strokeBorder(DesignTokens.Colors.glassRowBorder, lineWidth: 0.5))
+    }
+}
