+import SwiftUI
+
+@MainActor
+struct FirstRunOnboardingView: View {
+    @Bindable var settings: SettingsManager
+    @Bindable var accessibility: AccessibilityPermissionService
+    let onClose: () -> Void
+
+    @State private var page = 0
+
+    private let pageCount = 3
+
+    var body: some View {
+        VStack(spacing: 0) {
+            HStack {
+                Spacer()
+                Button("Skip") { complete() }
+                    .buttonStyle(.plain)
+                    .foregroundStyle(.secondary)
+                    .padding(18)
+            }
+
+            Group {
+                switch page {
+                case 0: welcomePage
+                case 1: permissionPage
+                default: tryItPage
+                }
+            }
+            .id(page)
+            .transition(.opacity)
+
+            HStack(spacing: 8) {
+                ForEach(0..<pageCount, id: \.self) { index in
+                    Capsule()
+                        .fill(index == page ? Color.accentColor : Color.secondary.opacity(0.25))
+                        .frame(width: index == page ? 22 : 7, height: 7)
+                        .animation(DesignTokens.Animation.quick, value: page)
+                }
+            }
+            .padding(.bottom, 12)
+
+            HStack {
+                if page > 0 {
+                    Button("Back") { move(to: page - 1) }
+                        .buttonStyle(.bordered)
+                }
+                Spacer()
+                if page < pageCount - 1 {
+                    Button("Continue") { move(to: page + 1) }
+                        .buttonStyle(.borderedProminent)
+                } else {
+                    Button("Start Using Melo") { complete() }
+                        .buttonStyle(.borderedProminent)
+                }
+            }
+            .padding(20)
+        }
+        .frame(width: 560, height: 430)
+        .background(.regularMaterial)
+    }
+
+    private var welcomePage: some View {
+        onboardingPage(
+            symbol: "slider.horizontal.3",
+            title: "Meet Melo",
+            message: "Control each app's volume and choose where it plays, right from the menu bar.",
+            detail: "Your sound stays on this Mac. Melo does not upload or record it."
+        )
+    }
+
+    private var permissionPage: some View {
+        onboardingPage(
+            symbol: accessibility.isTrustedCached ? "checkmark.shield.fill" : "hand.raised.fill",
+            title: accessibility.isTrustedCached ? "Access Granted" : "One Permission, Explained",
+            message: "Melo uses Accessibility so your Mac's volume keys can control Melo.",
+            detail: "macOS asks you to approve this once. You can remove access later in System Settings."
+        ) {
+            if accessibility.isTrustedCached {
+                Label("Ready", systemImage: "checkmark.circle.fill")
+                    .foregroundStyle(.green)
+                    .font(.system(size: 13, weight: .semibold))
+            } else {
+                Button("Allow Access") { accessibility.requestAccess() }
+                    .buttonStyle(.borderedProminent)
+                Button("Open System Settings") { accessibility.openSystemSettings() }
+                    .buttonStyle(.bordered)
+            }
+        }
+    }
+
+    private var tryItPage: some View {
+        onboardingPage(
+            symbol: "speaker.wave.2.fill",
+            title: "Try One Small Thing",
+            message: "Play audio in any app, open Melo from the menu bar, then move only that app's slider.",
+            detail: "The rest of your Mac stays at the same volume."
+        )
+    }
+
+    private func onboardingPage<Actions: View>(
+        symbol: String,
+        title: String,
+        message: String,
+        detail: String,
+        @ViewBuilder actions: () -> Actions
+    ) -> some View {
+        VStack(spacing: 18) {
+            Image(systemName: symbol)
+                .font(.system(size: 44, weight: .semibold))
+                .symbolRenderingMode(.hierarchical)
+                .foregroundStyle(.tint)
+                .frame(width: 86, height: 86)
+                .background(Circle().fill(.tint.opacity(0.12)))
+
+            Text(title)
+                .font(.system(size: 26, weight: .semibold, design: .rounded))
+
+            Text(message)
+                .font(.system(size: 16, weight: .medium))
+                .multilineTextAlignment(.center)
+                .frame(maxWidth: 400)
+
+            Text(detail)
+                .font(.system(size: 12))
+                .foregroundStyle(.secondary)
+                .multilineTextAlignment(.center)
+                .frame(maxWidth: 390)
+
+            HStack(spacing: 10) { actions() }
+                .padding(.top, 4)
+        }
+        .padding(.horizontal, 36)
+        .frame(maxWidth: .infinity, maxHeight: .infinity)
+    }
+
+    private func onboardingPage(
+        symbol: String,
+        title: String,
+        message: String,
+        detail: String
+    ) -> some View {
+        onboardingPage(symbol: symbol, title: title, message: message, detail: detail) {
+            EmptyView()
+        }
+    }
+
+    private func move(to newPage: Int) {
+        withAnimation(DesignTokens.Animation.quick) {
+            page = min(pageCount - 1, max(0, newPage))
+        }
+    }
+
+    private func complete() {
+        settings.appSettings.onboardingVersionCompleted = 1
+        onClose()
+    }
+}
