+import SwiftUI
+
+@MainActor
+struct ConsumerCommandPalette: View {
+    @Bindable var audioEngine: AudioEngine
+    let onOpenSettings: () -> Void
+
+    @Environment(\.dismiss) private var dismiss
+    @State private var searchText = ""
+
+    private struct Command: Identifiable {
+        let id: String
+        let title: String
+        let subtitle: String
+        let symbol: String
+        let category: ConsumerCommandCategory
+        let action: () -> Void
+    }
+
+    var body: some View {
+        VStack(spacing: 0) {
+            HStack(spacing: 10) {
+                Image(systemName: "magnifyingglass")
+                    .foregroundStyle(.secondary)
+                TextField("What would you like Melo to do?", text: $searchText)
+                    .textFieldStyle(.plain)
+                    .font(.system(size: 15))
+            }
+            .padding(14)
+            .background(.regularMaterial)
+
+            Divider()
+
+            ScrollView {
+                LazyVStack(alignment: .leading, spacing: 4) {
+                    ForEach(ConsumerCommandCategory.allCases, id: \.self) { category in
+                        let categoryCommands = filteredCommands.filter { $0.category == category }
+                        if !categoryCommands.isEmpty {
+                            Text(category.rawValue.uppercased())
+                                .font(.system(size: 9, weight: .bold))
+                                .foregroundStyle(.tertiary)
+                                .padding(.horizontal, 14)
+                                .padding(.top, 12)
+                                .padding(.bottom, 3)
+
+                            ForEach(categoryCommands) { command in
+                                Button {
+                                    command.action()
+                                    dismiss()
+                                } label: {
+                                    HStack(spacing: 11) {
+                                        Image(systemName: command.symbol)
+                                            .font(.system(size: 14, weight: .semibold))
+                                            .foregroundStyle(.tint)
+                                            .frame(width: 28, height: 28)
+                                            .background(Circle().fill(.tint.opacity(0.12)))
+                                        VStack(alignment: .leading, spacing: 2) {
+                                            Text(command.title)
+                                                .font(.system(size: 12, weight: .medium))
+                                                .foregroundStyle(.primary)
+                                            Text(command.subtitle)
+                                                .font(.system(size: 10))
+                                                .foregroundStyle(.secondary)
+                                                .lineLimit(1)
+                                        }
+                                        Spacer()
+                                        Image(systemName: "return")
+                                            .font(.system(size: 9))
+                                            .foregroundStyle(.tertiary)
+                                    }
+                                    .padding(.horizontal, 12)
+                                    .padding(.vertical, 7)
+                                    .contentShape(Rectangle())
+                                }
+                                .buttonStyle(.plain)
+                            }
+                        }
+                    }
+
+                    if filteredCommands.isEmpty {
+                        VStack(spacing: 8) {
+                            Image(systemName: "magnifyingglass")
+                                .font(.system(size: 24))
+                                .foregroundStyle(.tertiary)
+                            Text("No matching action")
+                                .font(.system(size: 12, weight: .medium))
+                            Text("Try a Scene name, device, volume, undo, or help.")
+                                .font(.system(size: 10))
+                                .foregroundStyle(.secondary)
+                        }
+                        .frame(maxWidth: .infinity)
+                        .padding(.vertical, 40)
+                    }
+                }
+                .padding(.bottom, 12)
+            }
+        }
+        .frame(width: 520, height: 460)
+    }
+
+    private var filteredCommands: [Command] {
+        let query = searchText.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard !query.isEmpty else { return commands }
+        return commands.filter {
+            $0.title.localizedCaseInsensitiveContains(query)
+                || $0.subtitle.localizedCaseInsensitiveContains(query)
+                || $0.category.rawValue.localizedCaseInsensitiveContains(query)
+        }
+    }
+
+    private var commands: [Command] {
+        var result: [Command] = []
+
+        for scene in audioEngine.settingsManager.consumerScenes {
+            result.append(Command(
+                id: "scene-\(scene.id.uuidString)",
+                title: "Use \(scene.name)",
+                subtitle: "Restore its volumes, devices, sound, and effects",
+                symbol: scene.symbolName,
+                category: .scenes,
+                action: { audioEngine.applyConsumerScene(scene) }
+            ))
+        }
+
+        for device in audioEngine.outputDevices {
+            result.append(Command(
+                id: "device-\(device.uid)",
+                title: "Play through \(device.name)",
+                subtitle: "Make this the main output",
+                symbol: "speaker.wave.2.fill",
+                category: .devices,
+                action: { _ = audioEngine.setDefaultOutputDevice(device.id) }
+            ))
+        }
+
+        result.append(Command(
+            id: "undo",
+            title: "Undo Last Change",
+            subtitle: audioEngine.consumerUndoManager.latest?.label ?? "Nothing recent to undo",
+            symbol: "arrow.uturn.backward",
+            category: .controls,
+            action: { audioEngine.undoLastConsumerChange() }
+        ))
+
+        let smartSoundEnabled = audioEngine.settingsManager.appSettings.adaptiveAudio.enabled
+        result.append(Command(
+            id: "smart-sound",
+            title: smartSoundEnabled ? "Turn Off Smart Sound" : "Turn On Smart Sound",
+            subtitle: "Keeps volume changes comfortable and speech easier to hear",
+            symbol: "ear.badge.waveform",
+            category: .controls,
+            action: {
+                var adaptive = audioEngine.settingsManager.appSettings.adaptiveAudio
+                adaptive.enabled.toggle()
+                audioEngine.setAdaptiveAudioSettings(adaptive)
+            }
+        ))
+
+        result.append(Command(
+            id: "repair",
+            title: "Fix Audio",
+            subtitle: "Refresh Melo’s audio connections without erasing settings",
+            symbol: "wrench.and.screwdriver.fill",
+            category: .help,
+            action: { audioEngine.repairConsumerAudio() }
+        ))
+
+        result.append(Command(
+            id: "settings",
+            title: "Open Melo Settings",
+            subtitle: "Scenes, automations, appearance, audio, and shortcuts",
+            symbol: "gearshape.fill",
+            category: .help,
+            action: onOpenSettings
+        ))
+
+        return result
+    }
+}
