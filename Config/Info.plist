	<key>CFBundleShortVersionString</key>
	<string>3.1.2</string>
	<!-- Audio files Melo Edit can open. LSHandlerRank is Alternate on
	     purpose: Melo appears in "Open With" for these types and accepts a drop
	     on its Dock tile, but never becomes the default handler for anyone's
	     music library. A menu-bar utility that quietly takes over double-click
	     on every .mp3 on the Mac is a large claim nobody asked for, and
	     Melo Edit's own window is the intended way in. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Audio</string>
			<key>CFBundleTypeRole</key>
